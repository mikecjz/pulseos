{
  // Browser half of PulseOS packages (DOM lib, React JSX), checked like DSH client packages.
  "extends": "./dsh/tsconfig.base.client.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "typeRoots": ["./dsh/scripts/types", "./dsh/node_modules/@types"],
    "types": ["client-build-environment", "client-assets", "node"]
  },
  "include": ["packages/seq/viewer/src/client", "packages/seq/viewer/tests", "packages/sim/viewer/src/client", "packages/sim/viewer/tests", "packages/app/brand/src/client"],
  "references": [
    { "path": "./dsh/vendor/cordis" },
    { "path": "./dsh/packages/client/ui-sidebar" },
    { "path": "./dsh/packages/client/ui-sidebar-right" },
    { "path": "./dsh/packages/client/ui-renderer" },
    { "path": "./dsh/packages/client/ui-session" },
    { "path": "./dsh/packages/api/session-controller/tsconfig.client.json" },
    { "path": "./dsh/packages/client/ui-conversation/tsconfig.client.json" },
    { "path": "./dsh/packages/client/ui-input-trigger" },
    { "path": "./dsh/packages/client/ui-theme/tsconfig.client.json" }
  ]
}
