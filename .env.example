# Template for the team .env. Do not put real values here: the real .env is
# git-ignored and comes from Infisical (`pnpm run secrets:pull`, see docs/secrets.md).

# HTTPS proxy for model APIs (e.g. DeepSeek). When set, scripts/dsh.mjs starts
# DSH with NODE_USE_ENV_PROXY=1 so Node's fetch/http go through it.
HTTPS_PROXY=

# Optional: DeepSeek API key, if not saved on the Web Models page.
# DEEPSEEK_API_KEY=
