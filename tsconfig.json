{
  // Type-checks PulseOS sources. DSH packages are referenced projects: `tsc -b`
  // checks them under their own compiler options and emits their declarations
  // into dsh/**/lib/types (git-ignored there), which this program then reads.
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/*/src",
    "packages/*/*/tests",
    "apps/*/tests"
  ],
  "exclude": ["packages/seq/viewer/src/client", "packages/seq/viewer/tests"],
  "references": [
    { "path": "./dsh/vendor/cosmokit" },
    { "path": "./dsh/vendor/schemastery" },
    { "path": "./dsh/vendor/cordis" },
    { "path": "./dsh/packages/core/session" },
    { "path": "./dsh/packages/session/session-projection" },
    { "path": "./dsh/packages/subprocess/subprocess" },
    { "path": "./dsh/packages/core/tools" },
    { "path": "./dsh/packages/llm/llm" },
    { "path": "./dsh/packages/core/agent" }
  ]
}
